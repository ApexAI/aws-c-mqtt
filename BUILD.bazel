load("@apex//tools/bazel/rules_ros_pkg:defs.bzl", "ros_pkg")

cc_library(
    name = "aws_c_mqtt",
    srcs = glob(
        ["source/**/*.c"],
    ),
    hdrs = glob(
        [
            "include/aws/**/*.h",
        ],
    ),
    defines = ["AWS_MQTT_WITH_WEBSOCKETS=1"],
    includes = ["."],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "@aws_c_common",
        "@aws_c_http",
        "@aws_c_io",
    ],
)

ros_pkg(
    name = "aws_c_mqtt_pkg",
    bst_substitute_with = select({
        "@apex//common/build_system_transfer:use_cmake_find_package": {
            "name": "aws-c-mqtt",
            "cmake_find_package": """\
find_package(aws-c-mqtt REQUIRED)
if (NOT TARGET {pkg_name}::aws_c_mqtt)
    add_library({pkg_name}::aws_c_mqtt ALIAS AWS::aws-c-mqtt)
endif()
""",
        },
        "//conditions:default": {
        },
    }),
    cc_libraries = [":aws_c_mqtt"],
    description = "C99 implementation of the MQTT 3.1.1 specification.",
    license = "Apex.AI Proprietary License",
    maintainer_email = "support@apex.ai",
    maintainer_name = "Apex.AI",
    pkg_name = "aws_c_mqtt_vendor",
    version = "0.10.3",
    visibility = ["//visibility:public"],
    deps = [
        "@aws_c_common//:aws_c_common_pkg",
        "@aws_c_http//:aws_c_http_pkg",
        "@aws_c_io//:aws_c_io_pkg",
    ],
)
